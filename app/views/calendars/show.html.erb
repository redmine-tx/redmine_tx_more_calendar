<%= javascript_include_tag('toastui-calendar.min.js', plugin: 'redmine_tx_more_calendar') %>
<%= stylesheet_link_tag('toastui-calendar.min.css', plugin: 'redmine_tx_more_calendar') %>


<!-- 텍스트 볼드 해제를 위한 스타일 -->
<style>
  .toastui-calendar-template-allday,
  .toastui-calendar-event-title {
    font-size: 11px;
    font-weight: normal !important;
  }
</style>


<h2><%= @query.new_record? ? l(:label_calendar) : @query.name %></h2>
<%= @query.persisted? && @query.description.present? ? content_tag('p', @query.description, class: 'subtitle') : '' %>

<%= form_tag({:controller => 'calendars', :action => 'show', :project_id => @project},
             :method => :get, :id => 'query_form') do %>
<%= hidden_field_tag 'set_filter', '1' %>
<%= hidden_field_tag 'calendar', '1' %>

<%
  @calendar_tracker = Setting.plugin_redmine_tx_more_calendar['calendar_tracker'].to_s.tr('[]" ','').split(',').map(&:to_i)
%>

<% Holiday.update() %>

<div id="query_form_with_buttons" class="hide-when-print">
<% if Setting.plugin_redmine_tx_more_calendar['hide_query_form'].to_s != "true" %>
<div id="query_form_content">
  <fieldset id="filters" class="collapsible <%= @query.new_record? ? "" : "collapsed" %>">
    <legend onclick="toggleFieldset(this);" class="icon icon-<%= @query.new_record? ? "expanded" : "collapsed" %>">
      <%= sprite_icon(@query.new_record? ? "angle-down" : "angle-right") %>
      <%= l(:label_filter_plural) %>
    </legend>
    <div style="<%= @query.new_record? ? "" : "display: none;" %>">
      <%= render :partial => 'queries/filters', :locals => {:query => @query} %>
    </div>
  </fieldset>
</div>
<% end %>

<%
def get_calendar_with_events( date )
  if @calendar_tracker.empty?
    @calendar_tracker = Tracker.all.map(&:id)
  end
  calendar = Redmine::Helpers::Calendar.new( date, current_language, :month)

  events = []

  unless @calendar_tracker.empty?
    events += Issue.where("(((start_date BETWEEN ? AND ?) OR (due_date BETWEEN ? AND ?)) OR ( start_date IS NOT NULL AND due_date IS NULL AND start_date < ? AND due_date > ?)) AND tracker_id IN (?)",
        calendar.startdt, calendar.enddt,
        calendar.startdt, calendar.enddt,
        calendar.startdt, calendar.enddt,
        @calendar_tracker
    ).to_a
  end

  events += @query.versions(
    :conditions => [
      "effective_date BETWEEN ? AND ?",
      calendar.startdt, calendar.enddt
    ]
  ).select { |v| v.open? }

  versions_for_marks = Version.where( "effective_date BETWEEN ? AND ?", calendar.startdt, calendar.enddt + 6.months ).select { |v| v.open? }
  versions_for_marks.each do |v|
    events += v.marks.select { |m| m[:date] >= calendar.startdt && m[:date] <= calendar.enddt }.map { |_| TxMoreCalendarHelper::CalendarEvent.new( _[:name], _[:date], nil, v ) }
  end

  if Setting.plugin_redmine_tx_more_calendar['hide_query_form'].to_s != "true" then
    events += @query.issues(
      :include => [:tracker, :assigned_to, :priority],
      :conditions => [
        "( ((start_date BETWEEN ? AND ?) OR (due_date BETWEEN ? AND ?)) OR ( start_date IS NOT NULL AND due_date IS NULL AND start_date < ? AND due_date > ? ) )",
        calendar.startdt, calendar.enddt,
        calendar.startdt, calendar.enddt,
        calendar.startdt, calendar.enddt
      ]
    )
  end

  calendar.events = events
  calendar
end
%>

<span class="contextual pagination">
  <ul class="pages">
    <li class="previous page">
      <%= link_to_previous_month(@year, @month, :accesskey => accesskey(:previous)) %>
    </li><li class="next page">
      <%= link_to_next_month(@year, @month, :accesskey => accesskey(:next)) %>
    </li>
  </ul>
</span>

<p class="buttons">
  <%= label_tag('month', l(:label_month)) %>
  <%= select_month(@month, :prefix => "month", :discard_type => true) %>
  <%= label_tag('year', l(:label_year)) %>
  <%= select_year(@year, :prefix => "year", :discard_type => true) %>

  <%= link_to_function sprite_icon('checked', l(:button_apply)), '$("#query_form").submit()', :class => 'icon icon-checked' %>
  <%= link_to sprite_icon('reload', l(:button_clear)), { :project_id => @project, :set_filter => 1 }, :class => 'icon icon-reload' %>

  <% if Setting.plugin_redmine_tx_more_calendar['hide_query_form'].to_s != "true" %>
    <% if @query.new_record? && User.current.allowed_to?(:save_queries, @project, :global => true) %>
      <%= link_to_function sprite_icon('save', l(:button_save_object, object_name: l(:label_query)).capitalize),
                          "$('#query_form').attr('action', '#{ @project ? new_project_query_path(@project) : new_query_path }').submit();",
                          :class => 'icon icon-save' %>
    <% end %>
    <% if !@query.new_record? && @query.editable_by?(User.current) %>
      <%= link_to sprite_icon('edit', l(:button_edit_object, object_name: l(:label_query)).capitalize), edit_query_path(@query, :calendar => 1), :class => 'icon icon-edit' %>
      <%= delete_link query_path(@query, :calendar => 1), {}, l(:button_delete_object, object_name: l(:label_query)).capitalize %>
    <% end %>
  <% end %>
</p>
</div>
<% end %>

<%= error_messages_for 'query' %>
<% if @query.valid? %>

<% date = Date.new(@year, @month, 1) %>

<%= render :partial => 'common/calendar', :locals => {:calendar => get_calendar_with_events(date), :calendar_date => date, :no_include => true } %>
<% if true %>
  <br>
  <%= render :partial => 'common/calendar', :locals => {:calendar => get_calendar_with_events(date.next_month), :calendar_date => date.next_month, :no_include => true } %>
  <br>
  <%= render :partial => 'common/calendar', :locals => {:calendar => get_calendar_with_events(date.next_month.next_month), :calendar_date => date.next_month.next_month, :no_include => true } %>
<% end %>

<%= call_hook(:view_calendars_show_bottom, :year => @year, :month => @month, :project => @project, :query => @query) %>

<% end %>

<% content_for :sidebar do %>
    <%= render :partial => 'issues/sidebar' %>
<% end %>

<% html_title(l(:label_calendar)) -%>
